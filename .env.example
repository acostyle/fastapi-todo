# Application Settings
APP__NAME=Task Tracker
APP__DEBUG=false
APP__ENVIRONMENT=development  # development, production, testing
APP_PORT=8000

# Database Settings
DATABASE__URL=postgresql+asyncpg://todo:todo@db:5432/todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo

# Redis Settings
REDIS__URL=redis://redis:6379/0  # local: redis://localhost:6379/0
REDIS__TASK_LIST_TTL_SECONDS=300

# Database Settings (SQLite - comment DATABASE__URL to use)
DATABASE__DRIVER=aiosqlite
DATABASE__PATH=.
DATABASE__NAME=tasks.db
DATABASE__ECHO=false

# Security Settings (REQUIRED!)
SECURITY__SECRET_KEY=change-me-to-a-random-string-at-least-32-characters-long
SECURITY__ALGORITHM=HS256
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
